[Unit]
Description=Warden Hermes local credential helper
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/warden-hermes-credentials/linux_credentials_service.py
WorkingDirectory=/
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C
UnsetEnvironment=PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH SYSTEMD_CREDENTIAL_SECRET
RuntimeDirectory=warden-hermes-credentials
RuntimeDirectoryMode=0755
StateDirectory=warden-hermes-credentials
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/warden-hermes-credentials /var/lib/systemd/credential.secret
ReadWritePaths=/var/lib/warden-hermes-credentials /run/warden-hermes-credentials
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
