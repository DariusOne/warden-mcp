{
  "mcp_servers": {
    "vaultwarden": {
      "command": "/srv/warden/runtime/node-v22.23.4-linux-x64/bin/node",
      "args": [
        "/srv/warden/versions/REVIEWED_VERSION/dist/server.js",
        "--agent-safe",
        "--agent-root",
        "/srv/warden"
      ],
      "connect_timeout": 30,
      "timeout": 480,
      "elicitation": { "enabled": true, "timeout": 300 },
      "trust": "untrusted",
      "sampling": { "enabled": false },
      "tools": {
        "include": [
          "status", "search", "sync", "browser_open", "browser_state",
          "browser_fill_login", "browser_fill_totp", "browser_action",
          "mysql_query", "ssh_exec", "browser_close", "pause_access"
        ]
      }
    }
  }
}
